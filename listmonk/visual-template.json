      },
      "props": {
        "contents": "<style>@font-face { font-family: 'Bangers'; font-style: normal; font-weight: 400; font-display: swap; mso-font-alt: 'Arial Black'; src: url('https://newsletter.wirmachen.wien/uploads/assets/fonts/bangers-400.ttf') format('truetype'); } @font-face { font-family: 'Roboto'; font-style: normal; font-weight: 400; font-display: swap; mso-font-alt: 'Arial'; src: url('https://newsletter.wirmachen.wien/uploads/assets/fonts/roboto-400.ttf') format('truetype'); } @font-face { font-family: 'Roboto'; font-style: normal; font-weight: 700; font-display: swap; mso-font-alt: 'Arial'; src: url('https://newsletter.wirmachen.wien/uploads/assets/fonts/roboto-700.ttf') format('truetype'); } @font-face { font-family: 'Roboto'; font-style: italic; font-weight: 400; font-display: swap; mso-font-alt: 'Arial'; src: url('https://newsletter.wirmachen.wien/uploads/assets/fonts/roboto-400-italic.ttf') format('truetype'); } @font-face { font-family: 'Roboto'; font-style: italic; font-weight: 700; font-display: swap; mso-font-alt: 'Arial'; src: url('https://newsletter.wirmachen.wien/uploads/assets/fonts/roboto-700-italic.ttf') format('truetype'); }</style>"
      }
    }
  },
  "block-browser-link": {
    "type": "Text",
    "data": {
      "style": {
        "color": "#ffffff",
        "backgroundColor": "#00a77e",
        "fontSize": 16,
        "fontWeight": "normal",
        "textAlign": "center",
        "padding": {
          "top": 20,
          "bottom": 5,
          "right": 24,
          "left": 24
        }
      },
      "props": {
